{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode 2 applicability matrix",
  "type": "object",
  "required": ["schema_version", "platform", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "platform": { "const": "linux" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "trajectories"],
        "properties": {
          "tool": { "type": "string" },
          "trajectories": {
            "type": "object",
            "required": ["T1", "T2", "T3", "T4", "T5", "T6", "T7"],
            "additionalProperties": {
              "type": "string",
              "pattern": "^(applicable|n/a:[^:]+|expected_fail:.+)$"
            }
          },
          "verdict_exclusions": {
            "description": "Parts of a trajectory's verdict this row does not judge. Unlike expected_fail it claims nothing about the outcome: it names one thing the harness leaves out, the evidence it rests on, and why leaving it out does not change what the row measures. Only subjects the harness implements may be named. A subject about a defect cites the upstream issue; a subject about deliberate host behaviour cites the captured host source instead, which the run re-reads out of the pinned binary.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["subject", "reason"],
              "properties": {
                "subject": { "enum": ["v1_host_process_exit", "v1_host_edit_family_gate"] },
                "issue": { "type": "string", "pattern": "^https://\\S+/[0-9]+$" },
                "host_source": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              },
              "oneOf": [{ "required": ["issue"] }, { "required": ["host_source"] }],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
