{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode 2 Docker scenario registration",
  "type": "object",
  "required": ["schema_version", "tool", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "id", "tool", "trajectory", "execution", "prompt", "turns"],
        "properties": {
          "schema_version": { "const": 1 },
          "id": { "type": "string", "pattern": "^[^/]+/T[1-7](?:/.*)?$" },
          "tool": { "type": "string" },
          "trajectory": { "enum": ["T1", "T2", "T3", "T4", "T5", "T6", "T7"] },
          "execution": { "enum": ["standalone", "shared-server"] },
          "prompt": { "type": "string", "minLength": 1 },
          "turns": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
