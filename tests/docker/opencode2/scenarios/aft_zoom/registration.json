{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "zoom",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "zoom/T1/happy",
      "tool": "zoom",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic zoom fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "zoom-happy",
                "name": "aft_zoom",
                "arguments": {
                  "path": "sample.ts",
                  "symbols": "uniqueScenarioSymbol"
                },
                "non_mutating_evidence": {
                  "reason": "zoom only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "zoom-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>uniqueScenarioSymbol))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "uniqueScenarioSymbol"
        }
      }
    },
    {
      "schema_version": 1,
      "id": "zoom/T2/invalid_arguments",
      "tool": "zoom",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted zoom call with an invalid argument type.",
      "fixture": "./fixture",
      "subcase": "invalid_arguments",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "zoom-invalid",
                "name": "aft_zoom",
                "arguments": {
                  "path": 42
                },
                "non_mutating_evidence": {
                  "reason": "the host rejects the argument type before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    }
  ]
}
