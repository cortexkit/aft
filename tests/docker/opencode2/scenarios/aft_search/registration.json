{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "search",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "search/T1/happy",
      "tool": "search",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic search fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "search-happy",
                "name": "aft_search",
                "arguments": {
                  "query": "uniqueScenarioSymbol",
                  "topK": 10
                },
                "non_mutating_evidence": {
                  "reason": "search only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "search-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>uniqueScenarioSymbol))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "uniqueScenarioSymbol"
        }
      }
    },
    {
      "schema_version": 1,
