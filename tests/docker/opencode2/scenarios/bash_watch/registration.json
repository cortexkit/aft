{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "bash_watch",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "bash_watch/T1/happy",
      "tool": "bash_watch",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic bash_watch fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "setup-background",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_watch-setup",
                "name": "bash",
                "arguments": {
                  "command": "sleep 2; printf 'watch fixture\\n'",
                  "background": true
                },
                "non_mutating_evidence": {
                  "reason": "the setup task writes stdout only"
                },
                "outlives_result": true
              }
            ]
          }
        },
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_watch-happy",
                "name": "bash_watch",
                "arguments": {
                  "taskId": "{{task_id:bash_watch-setup}}",
                  "timeoutMs": 1000
                },
                "non_mutating_evidence": {
                  "reason": "bash_watch only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "setup-background",
        "call-tool",
        "finish"
      ],
      "compare_call_id": "bash_watch-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>task))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "task"
        }
      }
    },
    {
      "schema_version": 1,
      "id": "bash_watch/T2/invalid_arguments",
      "tool": "bash_watch",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted bash_watch call with an invalid argument type.",
      "fixture": "./fixture",
      "subcase": "invalid_arguments",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_watch-invalid",
                "name": "bash_watch",
                "arguments": {
                  "taskId": 42
                },
                "non_mutating_evidence": {
                  "reason": "the host rejects the argument type before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    },
    {
      "schema_version": 1,
      "id": "bash_watch/T2/missing_target",
      "tool": "bash_watch",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted bash_watch call without its required target.",
      "fixture": "./fixture",
      "subcase": "missing_target",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_watch-missing",
                "name": "bash_watch",
                "arguments": {},
                "non_mutating_evidence": {
                  "reason": "the host rejects missing required arguments before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    }
  ]
}
