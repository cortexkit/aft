    {
      "schema_version": 1,
      "id": "delete/T3/delete_ask_allow",
      "tool": "delete",
      "trajectory": "T3",
      "expected_fail_issue": "https://github.com/anomalyco/opencode/issues/37164",
      "execution": "shared-server",
      "prompt": "Allow the delete mutation and restore its checkpoint.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "checkpoint",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "delete-checkpoint",
                "name": "aft_safety",
                "arguments": {
                  "op": "checkpoint",
                  "name": "delete-t3",
                  "files": [
                    "delete-me.txt"
                  ]
                },
                "non_mutating_evidence": {
                  "reason": "checkpoint creation does not alter the fixture project"
                }
              }
            ]
          }
        },
        {
          "label": "mutate",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "delete-allow-mutation",
                "name": "aft_delete",
                "arguments": {
                  "files": [
                    "delete-me.txt"
                  ]
                },
                "disk_effects": [
                  "delete-me.txt"
                ]
              }
            ]
          }
        },
        {
          "label": "restore",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "delete-restore",
                "name": "aft_safety",
                "arguments": {
                  "op": "restore",
                  "name": "delete-t3"
                },
                "disk_effects": [
                  "delete-me.txt"
                ]
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "checkpoint",
        "mutate",
        "restore",
        "finish"
      ],
      "restore_evidence": {
        "operation": "checkpoint_restore",
        "identifier": "delete-t3",
        "calls": [
          {
            "tool": "aft_safety",
            "arguments": {
              "op": "checkpoint",
              "name": "delete-t3",
              "files": [
                "delete-me.txt"
              ]
            }
          },
          {
            "tool": "aft_delete",
            "arguments": {
              "files": [
                "delete-me.txt"
              ]
            }
          },
          {
            "tool": "aft_safety",
            "arguments": {
              "op": "restore",
              "name": "delete-t3"
            }
          }
        ],
        "paths": [
          {
            "path": "delete-me.txt",
            "transition": "delete"
          }
        ]
      },
      "metadata": {
        "permission": {
          "operation": "delete",
          "reply": "once",
          "requested_paths": [
            "delete-me.txt"
          ]
        },
        "harness_blocker": "ApiControlPlan cannot interpolate the pending permission request id"
      }
    },
