{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "inspect",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "inspect/T1/happy",
      "tool": "inspect",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic inspect fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "inspect-happy",
                "name": "aft_inspect",
                "arguments": {
                  "sections": "todos",
                  "scope": ".",
                  "topK": 20
                },
                "non_mutating_evidence": {
                  "reason": "inspect only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "inspect-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>TODO))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "TODO"
        }
      }
    },
    {
      "schema_version": 1,
      "id": "inspect/T2/invalid_arguments",
      "tool": "inspect",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted inspect call with an invalid argument type.",
      "fixture": "./fixture",
      "subcase": "invalid_arguments",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "inspect-invalid",
                "name": "aft_inspect",
                "arguments": {
                  "sections": 42
                },
                "non_mutating_evidence": {
                  "reason": "the host rejects the argument type before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    },
    {
      "schema_version": 1,
      "id": "inspect/T4/abort",
      "tool": "inspect",
      "trajectory": "T4",
      "execution": "shared-server",
      "prompt": "Start and abort the deferred inspect call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "inspect-abort",
                "name": "aft_inspect",
                "arguments": {
                  "sections": "all",
                  "scope": ".",
                  "topK": 100
                },
                "non_mutating_evidence": {
                  "reason": "aborted inspection does not mutate the project"
                },
                "outlives_result": true
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "controls": [
        {
          "id": "inspect-abort-control",
          "after_turn": "call-tool",
          "delay_ms": 1000,
          "method": "POST",
          "path": "/api/session/{{session_id}}/abort",
          "expected_status": 0,
          "purpose": "abort"
        }
      ],
      "metadata": {
        "accepted_exit_codes": [
          0,
          130
        ],
        "harness_blocker": "ApiControlPlan cannot interpolate the active session id"
      }
    },
    {
      "schema_version": 1,
