    {
      "schema_version": 1,
      "id": "bash/T3/fallback_ask_allow",
      "tool": "bash",
      "trajectory": "T3",
      "auto": true,
      "execution": "shared-server",
      "prompt": "Run the fallback bash path in a session that approves the asks it is shown.",
      "fixture": "./fixture",
      "project_config": {
        "bash": {
          "host_fallback": true
        }
      },
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-fallback-ask_allow",
                "name": "bash",
                "arguments": {
                  "command": "printf 'fallback permission fixture\\n' > bash-fallback.txt"
                },
                "non_mutating_evidence": {
                  "reason": "the refused command never runs, so bash-fallback.txt keeps its fixture bytes and the whole-tree snapshot stays unchanged"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "metadata": {
        "permission": {
          "operation": "bash:host-fallback",
          "reply": "once"
        },
        "dead_transport": {
          "outcome": "refusal",
          "refusal_names": [
            "Binary (crashed|killed)",
            "outcome is UNKNOWN"
          ],
          "host_fallback_coverage": "n/a:standalone-transport-reports-every-failure-as-unknown-outcome",
          "reason": "bash.host_fallback may only run a command the transport provably never sent. The standalone bridge cannot report that: it writes the request to the binary it spawned, so when that binary crashes or is killed the outcome is unknown, and bash refuses rather than risk running the command twice. The shapes the classifier does admit - module down, bind timed out, route closed before dispatch - are daemon-transport replies, and this harness drives the standalone bridge through AFT_BINARY_PATH. Break-glass execution therefore has no coverage on this transport; covering it needs a harness that runs the daemon transport."
        }
      }
    },
