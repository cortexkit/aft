      "schema_version": 1,
      "id": "bash/T3/fallback_ask_allow",
      "tool": "bash",
      "trajectory": "T3",
      "auto": true,
      "execution": "shared-server",
      "prompt": "Run the fallback bash path in a session that approves the asks it is shown.",
      "fixture": "./fixture",
      "project_config": {
        "bash": {
          "host_fallback": true
        }
      },
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-fallback-ask_allow",
                "name": "bash",
                "arguments": {
                  "command": "printf 'fallback permission fixture\\n' > bash-fallback.txt"
                },
                "non_mutating_evidence": {
                  "reason": "the refused command never runs, so bash-fallback.txt keeps its fixture bytes and the whole-tree snapshot stays unchanged"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "metadata": {
        "permission": {
          "operation": "bash:host-fallback",
          "reply": "once"
        },
        "dead_transport": {
          "outcome": "refusal",
          "refusal_names": [
            "Binary (crashed|killed)",
            "outcome is UNKNOWN"
          ],
      "host_fallback_coverage": "n/a:this-row-installs-a-failure-whose-outcome-cannot-be-determined",
        "reason": "bash.host_fallback may only run a command the transport provably never sent, so this row installs the opposite failure: the stand-in the transport-dead window points AFT_BINARY_PATH at reads the bridge's request and only then exits, without answering it. The request has been handed over by the time the process dies, so nothing can say whether it ran, and bash refuses rather than risk running it twice. Break-glass execution therefore has no coverage here by construction - it needs a failure that proves nothing was sent, such as a binary that cannot start at all, which the OpenCode plugin's own e2e suite covers directly. An earlier version of this row left the dead window pointing at a missing binary, which is exactly that provably-never-sent failure: whether it refused or fell back depended on whether the bridge had already noticed its killed child, and on a CI runner it had, so the break-glass path opened and ran the command."
        }
      }
    },
