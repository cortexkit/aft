        {
          "label": "start-watch-source",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-watch-source",
                "name": "bash",
                "arguments": {
                  "command": "sleep 3; echo WATCH_MATCH; sleep 1; echo WATCH_MATCH",
                  "background": true
                },
                "non_mutating_evidence": {
                  "reason": "the watch source writes stdout only"
                },
                "outlives_result": true
              }
            ]
          }
        },
        {
          "label": "capture-task-id",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-watch-status",
                "name": "status",
                "arguments": {},
                "non_mutating_evidence": {
                  "reason": "status keeps the scripted turn open while the task id is captured"
                }
              }
            ]
          }
        },
        {
          "label": "arm-watch",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-arm-watch",
                "name": "bash_watch",
                "arguments": {
                  "taskId": "{{task_id:bash-watch-source}}",
                  "pattern": "WATCH_MATCH",
                  "background": true,
                  "once": true
                },
                "non_mutating_evidence": {
                  "reason": "arming a watch does not change fixture files"
                }
              }
            ]
          }
        },
        {
          "label": "idle-watch",
          "response": {
            "kind": "text",
            "content": "Waiting for the watch delivery."
          }
        },
        {
          "label": "finish-watch",
          "response": {
            "kind": "text",
            "content": "One watch delivery observed."
          }
        }
      ],
      "expected_turns": [
        "start-watch-source",
        "capture-task-id",
        "arm-watch",
        "idle-watch",
        "finish-watch"
      ],
      "metadata": {
        "t5": {
          "subcase": "watch_pattern_once",
          "pattern": "WATCH_MATCH",
          "setup_deadline_ms": 30000,
          "setup_phases": [
            "watch_arm",
            "first_match"
          ],
          "initial_delivery_deadline_ms": 30000,
          "initial_delivery_antecedent": "first matching task io/stdout after watch arm",
          "duplicate_detection_window": {
            "source": "product_rearm_ceiling_plus_one_tick",
            "tick_ms": 50
          }
        },
