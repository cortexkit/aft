      "id": "bash/T5/watch_pattern_once",
      "tool": "bash",
      "trajectory": "T5",
      "execution": "shared-server",
      "prompt": "Arm a one-shot watch before two matching stdout records and observe exactly one delivery.",
      "fixture": "./fixture",
      "quiescence_timeout_ms": 30000,
