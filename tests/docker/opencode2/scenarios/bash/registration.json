        {
          "label": "start-first",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-wake-first",
                "name": "bash",
                "arguments": {
                  "command": "sleep 5; printf 'first wake\\n' > completion-one.txt",
                  "background": true
                },
                "disk_effects": [
                  {
                    "path": "completion-one.txt",
                    "phase": "post_result"
                  }
                ],
                "outlives_result": true
              }
            ]
          }
        },
        {
          "label": "idle-first",
          "response": {
            "kind": "text",
            "content": "Waiting for the first completion."
