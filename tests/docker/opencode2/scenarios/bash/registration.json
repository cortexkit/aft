        },
        {
          "label": "start-second",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash-wake-second",
                "name": "bash",
                "arguments": {
                  "command": "sleep 5; printf 'second wake\\n' > completion-two.txt",
                  "background": true
                },
                "disk_effects": [
                  {
                    "path": "completion-two.txt",
                    "phase": "post_result"
                  }
                ],
                "outlives_result": true
              }
            ]
          }
        },
        {
          "label": "idle-second",
          "response": {
            "kind": "text",
            "content": "Waiting for the second completion."
          }
        },
        {
          "label": "finish-wakes",
          "response": {
            "kind": "text",
            "content": "Both completion wakes observed."
          }
        }
      ],
      "expected_turns": [
        "start-first",
        "idle-first",
        "start-second",
        "idle-second",
        "finish-wakes"
