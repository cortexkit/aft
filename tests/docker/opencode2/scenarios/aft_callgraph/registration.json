    {
      "schema_version": 1,
      "id": "callgraph/T1/happy",
      "tool": "callgraph",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic callgraph fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "callgraph-happy",
                "name": "aft_callgraph",
                "arguments": {
                  "op": "callers",
                  "path": "sample.ts",
                  "symbol": "root"
                },
                "non_mutating_evidence": {
                  "reason": "callgraph only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "callgraph-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>uniqueScenarioSymbol))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "uniqueScenarioSymbol"
        }
      }
    },
