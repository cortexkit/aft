{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "grep",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "grep/T1/happy",
      "tool": "grep",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic grep fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "grep-happy",
                "name": "grep",
                "arguments": {
                  "pattern": "UNIQUE",
                  "path": "."
                },
                "non_mutating_evidence": {
                  "reason": "grep only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "grep-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>sample\\.txt))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "sample.txt"
        }
      }
    },
    {
      "schema_version": 1,
