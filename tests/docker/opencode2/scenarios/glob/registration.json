{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "glob",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "glob/T1/happy",
      "tool": "glob",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic glob fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "glob-happy",
                "name": "glob",
                "arguments": {
                  "pattern": "sample.txt"
                },
                "non_mutating_evidence": {
                  "reason": "glob only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "glob-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>sample\\.txt))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "sample.txt"
        }
      }
    },
    {
