{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "bash_write",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "bash_write/T1/happy",
      "tool": "bash_write",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic bash_write fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-happy",
                "name": "bash_write",
                "arguments": {
                  "taskId": "{{task_id:setup}}",
                  "input": "fixture input"
                },
                "non_mutating_evidence": {
                  "reason": "bash_write only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "bash_write-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>task))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "task"
        }
      }
    },
    {
      "schema_version": 1,
      "id": "bash_write/T2/invalid_arguments",
      "tool": "bash_write",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted bash_write call with an invalid argument type.",
      "fixture": "./fixture",
      "subcase": "invalid_arguments",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-invalid",
                "name": "bash_write",
                "arguments": {
                  "taskId": 42
                },
                "non_mutating_evidence": {
                  "reason": "the host rejects the argument type before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    },
    {
      "schema_version": 1,
      "id": "bash_write/T2/missing_target",
      "tool": "bash_write",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted bash_write call without its required target.",
      "fixture": "./fixture",
      "subcase": "missing_target",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-missing",
                "name": "bash_write",
                "arguments": {},
                "non_mutating_evidence": {
                  "reason": "the host rejects missing required arguments before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    }
  ]
}
