{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "bash_write",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "bash_write/T1/happy",
      "tool": "bash_write",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic bash_write fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "setup-pty",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-setup",
                "name": "bash",
                "arguments": {
                  "command": "read line; printf '%s\\n' \"$line\"",
                  "pty": true,
                  "background": true
                },
                "non_mutating_evidence": {
                  "reason": "the PTY setup echoes input to stdout only"
                },
                "outlives_result": true
              }
            ]
          }
        },
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-happy",
                "name": "bash_write",
                "arguments": {
                  "taskId": "{{task_id:bash_write-setup}}",
                  "input": "fixture input\n"
                },
                "non_mutating_evidence": {
                  "reason": "bash_write only observes fixture state"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "setup-pty",
        "call-tool",
        "finish"
      ],
      "compare_call_id": "bash_write-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "bytes_written",
            "pattern": "^[\\s\\S]*\\\"bytes_written\\\": (?<value>\\d+)[\\s\\S]*$",
            "min_lines": 1,
            "max_lines": 10000,
            "types": {
              "value": "number"
            }
          }
        ],
        "expected": {
          "bytes_written": 14
        }
      }
    },
    {
      "schema_version": 1,
      "id": "bash_write/T2/invalid_arguments",
      "tool": "bash_write",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted bash_write call with an invalid argument type.",
      "fixture": "./fixture",
      "subcase": "invalid_arguments",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-invalid",
                "name": "bash_write",
                "arguments": {
                  "taskId": 42
                },
                "non_mutating_evidence": {
                  "reason": "the host rejects the argument type before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    },
    {
      "schema_version": 1,
      "id": "bash_write/T2/missing_target",
      "tool": "bash_write",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted bash_write call without its required target.",
      "fixture": "./fixture",
      "subcase": "missing_target",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "bash_write-missing",
                "name": "bash_write",
                "arguments": {},
                "non_mutating_evidence": {
                  "reason": "the host rejects missing required arguments before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    }
  ]
}
