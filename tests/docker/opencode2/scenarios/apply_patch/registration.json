{
  "$schema": "../../harness/registration.schema.json",
  "schema_version": 1,
  "tool": "apply_patch",
  "scenarios": [
    {
      "schema_version": 1,
      "id": "apply_patch/T1/happy",
      "tool": "apply_patch",
      "trajectory": "T1",
      "execution": "standalone",
      "auto": true,
      "prompt": "Run the deterministic apply_patch fixture call.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "apply_patch-happy",
                "name": "apply_patch",
                "arguments": {
                  "patchText": "*** Begin Patch\n*** Add File: patched.txt\n+patched by scenario\n*** End Patch"
                },
                "disk_effects": [
                  "patched.txt"
                ]
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "compare_call_id": "apply_patch-happy",
      "comparison": {
        "mode": "shape",
        "rules": [
          {
            "kind": "field",
            "field": "fixture_marker",
            "pattern": "^(?=[\\s\\S]*(?<value>patched\\.txt))[\\s\\S]+$",
            "min_lines": 1,
            "max_lines": 10000
          }
        ],
        "expected": {
          "fixture_marker": "patched.txt"
        }
      }
    },
    {
      "schema_version": 1,
      "id": "apply_patch/T2/invalid_arguments",
      "tool": "apply_patch",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted apply_patch call with an invalid argument type.",
      "fixture": "./fixture",
      "subcase": "invalid_arguments",
      "error_origin": "host",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "apply_patch-invalid",
                "name": "apply_patch",
                "arguments": {
                  "patchText": 42
                },
                "non_mutating_evidence": {
                  "reason": "the host rejects the argument type before execution"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ]
    },
    {
      "schema_version": 1,
      "id": "apply_patch/T2/missing_target",
      "tool": "apply_patch",
      "trajectory": "T2",
      "execution": "standalone",
      "auto": true,
      "prompt": "Attempt the scripted apply_patch call without its required target.",
      "fixture": "./fixture",
