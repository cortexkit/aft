    {
      "schema_version": 1,
      "id": "apply_patch/T3/apply_patch_ask_allow",
      "tool": "apply_patch",
      "trajectory": "T3",
      "expected_fail_issue": "https://github.com/anomalyco/opencode/issues/37164",
      "execution": "shared-server",
      "prompt": "Allow the apply_patch mutation and restore its checkpoint.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "checkpoint",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "apply_patch-checkpoint",
                "name": "aft_safety",
                "arguments": {
                  "op": "checkpoint",
                  "name": "apply_patch-t3",
                  "files": [
                    "patched.txt"
                  ]
                },
                "non_mutating_evidence": {
                  "reason": "checkpoint creation does not alter the fixture project"
                }
              }
            ]
          }
        },
        {
          "label": "mutate",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "apply_patch-allow-mutation",
                "name": "apply_patch",
                "arguments": {
                  "patchText": "*** Begin Patch\n*** Add File: patched.txt\n+patched by scenario\n*** End Patch"
                },
                "disk_effects": [
                  "patched.txt"
                ]
              }
            ]
          }
        },
        {
          "label": "restore",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "apply_patch-restore",
                "name": "aft_safety",
                "arguments": {
                  "op": "restore",
                  "name": "apply_patch-t3"
                },
                "disk_effects": [
                  "patched.txt"
                ]
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "checkpoint",
        "mutate",
        "restore",
        "finish"
      ],
      "restore_evidence": {
        "operation": "checkpoint_restore",
        "identifier": "apply_patch-t3",
        "calls": [
          {
            "tool": "aft_safety",
            "arguments": {
              "op": "checkpoint",
              "name": "apply_patch-t3",
              "files": [
                "patched.txt"
              ]
            }
          },
          {
            "tool": "apply_patch",
            "arguments": {
              "patchText": "*** Begin Patch\n*** Add File: patched.txt\n+patched by scenario\n*** End Patch"
            }
          },
          {
            "tool": "aft_safety",
            "arguments": {
              "op": "restore",
              "name": "apply_patch-t3"
            }
          }
        ],
        "paths": [
          {
            "path": "patched.txt",
            "transition": "create",
            "expected_intermediate_sha256": "406e6d91737234e64918ffeee7e3323a23f1574ecc29f000fa690b01add47f6c"
          }
        ]
      },
      "metadata": {
        "permission": {
          "operation": "apply_patch",
          "reply": "once",
          "requested_paths": [
            "patched.txt"
          ]
        },
        "harness_blocker": "ApiControlPlan cannot interpolate the pending permission request id"
      }
    },
