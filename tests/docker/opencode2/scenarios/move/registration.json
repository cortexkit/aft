      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "move-ask_deny",
                "name": "aft_move",
                "arguments": {
                  "path": "move-source.txt",
                  "destination": "move-destination.txt"
                },
                "non_mutating_evidence": {
                  "reason": "reject prevents fixture mutation"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "metadata": {
        "permission": {
          "operation": "move",
          "reply": "reject",
          "requested_paths": [
            "move-source.txt",
            "move-destination.txt"
          ]
        },
        "harness_blocker": "ApiControlPlan cannot interpolate the pending permission request id"
      }
    },
    {
      "schema_version": 1,
      "id": "move/T3/move_config_deny",
      "tool": "move",
      "trajectory": "T3",
      "execution": "shared-server",
      "prompt": "Configuration-deny the move mutation.",
      "fixture": "./fixture",
      "turns": [
        {
          "label": "call-tool",
          "response": {
            "kind": "tool_calls",
            "calls": [
              {
                "id": "move-config_deny",
                "name": "aft_move",
                "arguments": {
                  "path": "move-source.txt",
                  "destination": "move-destination.txt"
                },
                "non_mutating_evidence": {
                  "reason": "config_deny prevents fixture mutation"
                }
              }
            ]
          }
        },
        {
          "label": "finish",
          "response": {
            "kind": "text",
            "content": "done"
          }
        }
      ],
      "expected_turns": [
        "call-tool",
        "finish"
      ],
      "metadata": {
        "permission": {
          "operation": "move",
          "reply": "config_deny",
          "requested_paths": [
            "move-source.txt",
            "move-destination.txt"
          ]
        }
      }
    }
  ]
}
