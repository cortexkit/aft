{
  "format_on_edit": false,
  // The trigram index defaults on, so AFT's hoisted `grep`/`glob` tools are
  // registered and Pi's built-in `grep` (which skips AFT's external-directory
  // permission ask) never runs. Semantic indexing is off so a test run never
  // loads ONNX Runtime or downloads a model.
  "indexes": { "semantic": false },
  "auto_update": false
}
