{
  "command": "cargo clippy --fix --allow-dirty",
  "matches": false,
  "policy": {
    "commands": [
      "cd",
      "cargo build",
      "cargo check",
      "cargo test",
      "cargo nextest",
      "cargo clippy",
      "bun test"
    ],
    "enabled": true
  },
  "pty": false,
  "stdin": false
}
