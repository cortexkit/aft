<CardHeader title="Edit" />

<ToolText size="large" text={FileName(input.path)} />

<ToolText tone="muted" text={Folder(input.path)} />

{(view.completion.reason ?? view.record.reason) == "no_match" ? <ToolText text={"No match · " + (Count(input.edits ?? []) > 1 ? Text(Count(input.edits ?? [])) + " changes" : "1 change")} tone="danger" />
 : (view.completion.reason ?? view.record.reason) == "invalid_syntax" || (view.completion.reason ?? view.record.reason) == "syntax_error" ? <ToolText text="Invalid syntax" tone="danger" />
 : (view.completion.outcome ?? view.record.outcome) == "partial" ? <ToolText text="Partly applied" tone="warning" />
 : (view.completion.outcome ?? view.record.outcome) == "error" ? <ToolText text="Failed" tone="danger" />
 : (view.completion.outcome ?? view.record.outcome) == "success" ? <ToolText text={"Applied · " + (Count(input.edits ?? []) > 1 ? Text(Count(input.edits ?? [])) + " changes" : "1 change") + ((view.completion.addedLines ?? view.record.addedLines) != null && (view.completion.removedLines ?? view.record.removedLines) != null ? " · +" + Text(view.completion.addedLines ?? view.record.addedLines) + " −" + Text(view.completion.removedLines ?? view.record.removedLines) : "")} />
 : view.call.phase == "unanswered" ? <ToolText text="Not run" tone="muted" /> : null}

{view.detail.noMatchChange != null ? <ToolText text={"Change " + Text(view.detail.noMatchChange) + " · No match"} tone="danger" /> : null}

{view.detail.truncated == true ? <ToolText text="Only part of the diff was kept." tone="warning" /> : null}

{Count(view.detail.hunks ?? []) > 0 ? <Diff hunks={view.detail.hunks} /> : null}

{view.call.phase == "answered" && view.call.isError != true && view.detail.truncated != true && Count(view.detail.hunks ?? []) == 0
 ? <ToolText text="The full diff is no longer kept. This shows the changes the agent asked for." tone="warning" /> : null}

{view.call.phase == "answered" && view.call.isError != true && view.detail.truncated != true && Count(view.detail.hunks ?? []) == 0
 ? Each(input.edits ?? [], "edit", <CodeBlock codeString={(edit.oldString ?? "") + "\n→\n" + (edit.newString ?? edit.content ?? "")} maxLines={40} />)
 : null}

{view.call.phase == "answered" && view.call.isError != true && view.detail.truncated != true && Count(view.detail.hunks ?? []) == 0 && (input.appendContent != null || input.content != null)
 ? <CodeBlock codeString={"→\n" + (input.appendContent ?? input.content ?? "")} maxLines={40} /> : null}
