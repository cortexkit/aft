  "cursorContract": {
    "opaque": true,
    "positions": "per-stream original positions once a durable prefix base exists",
    "readSequence": "strictly increasing by one along each cursor chain, no wrap; not a clock or per-task database counter",
    "binding": "keyed MAC or task-bound encoding authenticates positions and sequence against the viewed task and session",
    "noProgress": "next differs from request even when positions are equal",
    "refusalCode": "malformed_cursor",
    "fixedMessage": "The page cursor is invalid for this read.",
    "frameRetry": "Identical frame-key replay returns the already stored body, including cursor; use a fresh frame key for a fresh page evaluation."
