        "placement": "items"
      },
      {
        "key": "stream",
        "source": "artifact stream",
        "required": true,
        "nullable": false,
        "placement": "items"
      },
      {
        "key": "text",
        "source": "one lossy UTF-8 decoded physical line or whole-unit part, without LF/CRLF terminator",
        "required": true,
        "nullable": false,
        "placement": "items"
      },
      {
        "key": "next",
        "source": "task/session-bound opaque cursor of per-stream positions plus incremented monotonic read sequence; changes even without position progress; null only at terminal drain",
        "required": true,
        "nullable": true,
        "placement": "next"
      },
      {
        "key": "continued",
        "source": "true when more parts of this same physical line follow; false on the last part",
        "required": true,
        "nullable": false,
        "placement": "items"
      },
      {
        "key": "firstAvailableOffset",
        "source": "durable per-stream cumulative dropped-prefix base; null only for legacy trimmed tasks with unknown original origin",
        "required": true,
        "nullable": true,
        "placement": "items"
      },
      {
        "key": "prefixDropped",
        "source": "true after any prefix trim (including legacy unknown origin); false only with a verified original base of zero",
        "required": true,
        "nullable": false,
        "placement": "items"
      }
    ]
  },
