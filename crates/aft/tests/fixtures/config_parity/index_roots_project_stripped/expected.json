{
  "aft_search_registered": true,
  "disabled_tools": [
    "aft_delete",
    "aft_move"
  ],
  "experimental_bash_background": true,
  "experimental_bash_compress": true,
  "experimental_bash_rewrite": true,
  "index": {
    "roots": [
      {
        "indexes": [
          "search"
        ],
        "path": "~/.aft-user-root"
      }
    ]
  },
  "indexes": {
    "callgraph": true,
    "semantic": true,
    "trigram": true
  },
  "restrict_to_project_root": false
}
