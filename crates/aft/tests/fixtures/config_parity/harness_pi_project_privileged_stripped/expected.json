{
  "aft_search_registered": true,
  "disabled_tools": [
    "aft_delete",
    "aft_move"
  ],
  "experimental_bash_background": true,
  "experimental_bash_compress": true,
  "experimental_bash_rewrite": true,
  "hashline_enabled": true,
  "indexes": {
    "callgraph": true,
    "semantic": true,
    "trigram": true
  },
  "restrict_to_project_root": true,
  "sandbox": {
    "enabled": true,
    "write_allow": [
      "/tmp/aft-user-write"
    ]
  },
  "semantic": {
    "api_key_env": "USER_KEY",
    "backend": "ollama",
    "base_url": "http://localhost:11434"
  }
}
