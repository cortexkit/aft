{
  "aft_search_registered": true,
  "disabled_tools": [
    "aft_delete",
    "aft_move"
  ],
  "experimental_bash_background": true,
  "experimental_bash_compress": true,
  "experimental_bash_rewrite": true,
  "indexes": {
    "callgraph": true,
    "semantic": true,
    "trigram": true
  },
  "restrict_to_project_root": false,
  "sandbox": {
    "enabled": true,
    "read_deny": [
      "/tmp/aft-sandbox-user-secret"
    ],
    "write_allow": [
      "/tmp/aft-sandbox-write"
    ]
  }
}
