export const outcome = view.completion.outcome ?? view.record.outcome
export const reason = view.completion.reason ?? view.record.reason
export const added = view.completion.addedLines ?? view.record.addedLines
export const removed = view.completion.removedLines ?? view.record.removedLines

<CardHeader title="Write" />

<ToolText size="large" text={FileName(input.path)} />

<ToolText tone="muted" text={Folder(input.path)} />

{reason == "invalid_syntax" || reason == "syntax_error" ? <ToolText text="Invalid syntax" tone="danger" />
 : outcome == "partial" ? <ToolText text="Partly applied" tone="warning" />
 : outcome == "error" ? <ToolText text="Failed" tone="danger" />
 : outcome == "success" ? <ToolText text={"Applied · 1 change" + (added != null && removed != null ? " · +" + Text(added) + " −" + Text(removed) : "")} />
 : view.call.phase == "unanswered" ? <ToolText text="Not run" tone="muted" /> : null}

<CodeBlock codeString={input.content} maxLines={40} />
