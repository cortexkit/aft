{
  "description": "P3 key admissibility and encoding.",
  "groups": {
    "P3": [
      {
        "name": "minimum length key is admissible",
        "kind": "material",
        "key": "0123456789abcdef",
        "label": "repo_key",
        "location": "header",
        "expect": {
          "admissible": true,
          "encoded": "0123456789abcdef",
          "error": null
        }
      },
      {
        "name": "15 byte key refuses",
        "kind": "material",
        "key": "0123456789abcde",
        "label": "repo_key",
        "location": "header",
        "expect": {
          "admissible": false,
          "encoded": null,
          "error": "too_short"
        }
      },
      {
        "name": "empty key refuses",
        "kind": "material",
        "key": "",
        "label": "repo_key",
        "location": "header",
        "expect": {
          "admissible": false,
          "encoded": null,
          "error": "empty"
        }
      },
      {
        "name": "key containing its label inside the placeholder refuses",
        "kind": "material",
        "key": "repo",
        "label": "repo_key",
        "location": "query",
        "expect": {
          "admissible": false,
          "encoded": null,
          "error": "in_placeholder"
        }
      },
      {
        "name": "query encoding leaves unreserved bytes literal",
        "kind": "material",
        "key": "a-b.c_d~e01234567890",
        "label": "repo_key",
        "location": "query",
        "expect": {
          "admissible": true,
          "encoded": "a-b.c_d~e01234567890",
          "error": null
        }
      },
      {
        "name": "query encoding uses uppercase hex for reserved bytes",
        "kind": "material",
        "key": "a b%c&d\"e\\f01234567",
        "label": "repo_key",
        "location": "query",
        "expect": {
          "admissible": true,
          "encoded": "a%20b%25c%26d%22e%5Cf01234567",
          "error": null
        }
      },
      {
        "name": "json encoding escapes quotes backslashes and newlines",
        "kind": "material",
        "key": "a\"b\\c\nd-0123456789",
        "label": "repo_key",
        "location": "json",
        "expect": {
          "admissible": true,
          "encoded": "a\\\"b\\\\c\\nd-0123456789",
          "error": null
        }
      },
      {
        "name": "header value with a control byte refuses",
        "kind": "material",
        "key": "a b\tc-0123456789",
        "label": "repo_key",
        "location": "header",
        "expect": {
          "admissible": false,
          "encoded": null,
          "error": "not_visible"
        }
      },
      {
        "name": "bearer value with a control byte refuses",
        "kind": "material",
        "key": "a b\u007fc-0123456789",
        "label": "repo_key",
        "location": "bearer",
        "expect": {
          "admissible": false,
          "encoded": null,
          "error": "not_visible"
        }
      }
    ]
  }
}
