{
  "description": "M2 path normalization, boundaries and wire form.",
  "groups": {
    "M2": [
      {
        "name": "prefix matches a whole segment",
        "kind": "path",
        "input": "/repos/a",
        "prefix": "/repos/a",
        "matches": true,
        "expect": {
          "normalized": "/repos/a",
          "wire": "/repos/a",
          "matches": true
        }
      },
      {
        "name": "prefix never matches a longer segment",
        "kind": "path",
        "input": "/repos/ab",
        "prefix": "/repos/a",
        "matches": false,
        "expect": {
          "normalized": "/repos/ab",
          "wire": "/repos/ab",
          "matches": false
        }
      },
      {
        "name": "prefix covers children",
        "kind": "path",
        "input": "/repos/a/files",
        "prefix": "/repos/a",
        "matches": true,
        "expect": {
          "normalized": "/repos/a/files",
          "wire": "/repos/a/files",
          "matches": true
        }
      },
      {
        "name": "dot segment is removed",
        "kind": "path",
        "input": "/repos/./a",
        "prefix": "/repos",
        "normalized": "/repos/a",
        "wire": "/repos/a",
        "matches": true,
        "expect": {
          "normalized": "/repos/a",
          "wire": "/repos/a",
          "matches": true
        }
      },
      {
        "name": "parent segment is removed",
        "kind": "path",
        "input": "/repos/x/../a",
        "prefix": "/repos",
        "normalized": "/repos/a",
        "wire": "/repos/a",
        "matches": true,
        "expect": {
          "normalized": "/repos/a",
          "wire": "/repos/a",
          "matches": true
        }
      },
      {
        "name": "escaped dot segments refuse as ambiguous",
        "kind": "path",
        "input": "/repos/a/%2E%2E/b",
        "prefix": "/repos",
        "normalized": "/repos/b",
        "wire": "/repos/b",
        "matches": true,
        "expect": {
          "error": "ambiguous_separator"
        }
      },
      {
        "name": "unreserved escapes are decoded",
        "kind": "path",
        "input": "/repos/%61/b",
        "prefix": "/repos",
        "normalized": "/repos/a/b",
        "wire": "/repos/a/b",
        "matches": true,
        "expect": {
          "normalized": "/repos/a/b",
          "wire": "/repos/a/b",
          "matches": true
        }
      },
      {
        "name": "other escapes stay percent-encoded on the wire",
        "kind": "path",
        "input": "/repos/a b",
        "prefix": "/repos",
        "normalized": "/repos/a b",
        "wire": "/repos/a%20b",
        "matches": true,
        "expect": {
          "normalized": "/repos/a b",
          "wire": "/repos/a%20b",
          "matches": true
        }
      },
      {
        "name": "semicolon segment refuses",
        "kind": "path",
        "input": "/repos/a/..;/admin",
        "prefix": "/repos",
        "error": "ambiguous_separator",
        "expect": {
          "error": "ambiguous_separator"
        }
      },
      {
        "name": "backslash in a segment refuses",
        "kind": "path",
        "input": "/repos/a\\b",
        "prefix": "/repos",
        "error": "ambiguous_separator",
        "expect": {
          "error": "ambiguous_separator"
        }
      },
      {
        "name": "escaped backslash refuses",
        "kind": "path",
        "input": "/repos/a/%5C../b",
        "prefix": "/repos",
        "error": "ambiguous_separator",
        "expect": {
          "error": "ambiguous_separator"
        }
      },
      {
        "name": "escaped slash refuses",
        "kind": "path",
        "input": "/repos/a%2Fb",
        "prefix": "/repos",
        "error": "ambiguous_separator",
        "expect": {
          "error": "ambiguous_separator"
        }
      },
      {
        "name": "empty segment refuses",
        "kind": "path",
        "input": "/repos//a",
        "prefix": "/repos",
        "error": "empty_segment",
        "expect": {
          "error": "empty_segment"
        }
      },
      {
        "name": "empty segment before a dot segment refuses",
        "kind": "path",
        "input": "/repos/a//../b",
        "prefix": "/repos",
        "error": "empty_segment",
        "expect": {
          "error": "empty_segment"
        }
      },
      {
        "name": "root prefix covers any path",
        "kind": "path",
        "input": "/anything",
        "prefix": "/",
        "matches": true,
        "expect": {
          "normalized": "/anything",
          "wire": "/anything",
          "matches": true
        }
      },
      {
        "name": "query is kept on the wire",
        "kind": "path",
        "input": "/repos/a?per_page=10",
        "prefix": "/repos",
        "normalized": "/repos/a",
        "wire": "/repos/a?per_page=10",
        "matches": true,
        "expect": {
          "normalized": "/repos/a",
          "wire": "/repos/a?per_page=10",
          "matches": true
        }
      },
      {
        "name": "http2 path form is origin-form",
        "kind": "path",
        "input": "/repos/a",
        "prefix": "/repos",
        "matches": true,
        "expect": {
          "normalized": "/repos/a",
          "wire": "/repos/a",
          "matches": true
        }
      },
      {
        "name": "absolute-form target is normalized",
        "kind": "path",
        "input": "https://api.example.com/repos/a",
        "prefix": "/repos",
        "normalized": "/repos/a",
        "wire": "/repos/a",
        "matches": true,
        "expect": {
          "normalized": "/repos/a",
          "wire": "/repos/a",
          "matches": true
        }
      },
      {
        "name": "http2 :path outside the prefix is literal",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/repos/a",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "/repos/ab",
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "literal"
          ],
          "refusal": null
        }
      },
      {
        "name": "an absolute-form target replaces the upstream path",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/repos",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "https://api.example.com/repos/%61",
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "substituted"
          ],
          "refusal": null,
          "header_edits": [
            {
              "name": "x-api-key",
              "replacement": "sk-live-0123456789abcdef",
              "kind": "whole_value"
            }
          ]
        }
      }
    ]
  }
}
