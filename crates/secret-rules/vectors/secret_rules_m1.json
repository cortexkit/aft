{
  "description": "M1 host and port matching.",
  "groups": {
    "M1": [
      {
        "name": "host is lowercased",
        "kind": "host",
        "input": "API.Example.COM",
        "expect": {
          "host": "api.example.com"
        }
      },
      {
        "name": "a trailing dot is not the same host",
        "kind": "host",
        "input": "api.example.com.",
        "expect": {
          "error": "malformed_authority"
        }
      },
      {
        "name": "unicode host maps to punycode",
        "kind": "host",
        "input": "B\u00dcCHER.example",
        "expect": {
          "host": "xn--bcher-kva.example"
        }
      },
      {
        "name": "punycode host stays ascii",
        "kind": "host",
        "input": "xn--bcher-kva.example",
        "expect": {
          "host": "xn--bcher-kva.example"
        }
      },
      {
        "name": "bracketed ipv6 is lowercased",
        "kind": "host",
        "input": "[2001:DB8::1]",
        "expect": {
          "host": "[2001:db8::1]"
        }
      },
      {
        "name": "empty host cannot parse",
        "kind": "host",
        "input": "",
        "expect": {
          "error": "malformed_authority"
        }
      },
      {
        "name": "bare ipv6 without brackets cannot parse",
        "kind": "host",
        "input": "2001:db8::1",
        "expect": {
          "error": "malformed_authority"
        }
      },
      {
        "name": "exact host and default port match",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "/v1/things",
        "host": "API.example.com",
        "port": 443,
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "substituted"
          ],
          "refusal": null,
          "header_edits": [
            {
              "name": "x-api-key",
              "replacement": "sk-live-0123456789abcdef",
              "kind": "whole_value"
            }
          ]
        }
      },
      {
        "name": "another host does not match",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "/v1/things",
        "host": "api.example.co",
        "port": 443,
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "literal"
          ],
          "refusal": null
        }
      },
      {
        "name": "a required port must equal the declared one",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 8443,
            "path_prefix": "/v1",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "/v1/things",
        "host": "api.example.com",
        "port": 443,
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "literal"
          ],
          "refusal": null
        }
      },
      {
        "name": "a non-default declared port matches only itself",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 8443,
            "path_prefix": "/v1",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "/v1/things",
        "host": "api.example.com",
        "port": 8443,
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "substituted"
          ],
          "refusal": null,
          "header_edits": [
            {
              "name": "x-api-key",
              "replacement": "sk-live-0123456789abcdef",
              "kind": "whole_value"
            }
          ]
        }
      },
      {
        "name": "idna spelling of the declared host matches",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "xn--bcher-kva.example",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "header",
              "name": "X-Api-Key"
            }
          }
        ],
        "target": "/v1/things",
        "host": "b\u00fccher.example",
        "port": 443,
        "headers": [
          {
            "name": "X-Api-Key",
            "value": "{{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "substituted"
          ],
          "refusal": null,
          "header_edits": [
            {
              "name": "x-api-key",
              "replacement": "sk-live-0123456789abcdef",
              "kind": "whole_value"
            }
          ]
        }
      }
    ]
  }
}
