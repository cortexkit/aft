{
  "description": "M4 request authority must equal the CONNECT authority.",
  "groups": {
    "M4": [
      {
        "name": "same authority is accepted",
        "kind": "authority",
        "connect": "api.example.com:443",
        "host": "api.example.com",
        "authority": "api.example.com:443",
        "target": "/v1/things",
        "expect": {
          "ok": true,
          "authority": "api.example.com:443"
        }
      },
      {
        "name": "default port is implied",
        "kind": "authority",
        "connect": "API.example.com:443",
        "host": "api.example.com",
        "target": "/v1/things",
        "expect": {
          "ok": true,
          "authority": "api.example.com:443"
        }
      },
      {
        "name": "another host header is refused",
        "kind": "authority",
        "connect": "api.example.com:443",
        "host": "other.example.com",
        "target": "/v1/things",
        "expect": {
          "ok": false,
          "error": "authority_mismatch"
        }
      },
      {
        "name": "another port header is refused",
        "kind": "authority",
        "connect": "api.example.com:443",
        "host": "api.example.com:8443",
        "target": "/v1/things",
        "expect": {
          "ok": false,
          "error": "authority_mismatch"
        }
      },
      {
        "name": "another http2 authority is refused",
        "kind": "authority",
        "connect": "api.example.com:443",
        "authority": "other.example.com:443",
        "target": "/v1/things",
        "expect": {
          "ok": false,
          "error": "authority_mismatch"
        }
      },
      {
        "name": "an absolute-form target to another host is refused",
        "kind": "authority",
        "connect": "api.example.com:443",
        "target": "https://other.example.com/v1/things",
        "expect": {
          "ok": false,
          "error": "authority_mismatch"
        }
      },
      {
        "name": "an absolute-form target to the same host is accepted",
        "kind": "authority",
        "connect": "api.example.com:443",
        "target": "https://api.example.com/v1/things",
        "expect": {
          "ok": true,
          "authority": "api.example.com:443"
        }
      }
    ]
  }
}
