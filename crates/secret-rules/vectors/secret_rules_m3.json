{
  "description": "M3 redirect hops are evaluated from scratch.",
  "groups": {
    "M3": [
      {
        "name": "same host same path prefix is authorized",
        "kind": "redirect",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "https://api.example.com/v1/next",
        "expect": {
          "authorized": [
            "repo_key"
          ],
          "reasons": []
        }
      },
      {
        "name": "another host is not authorized",
        "kind": "redirect",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "https://evil.example.com/v1/next",
        "expect": {
          "authorized": [],
          "reasons": [
            "repo_key:host_mismatch"
          ]
        }
      },
      {
        "name": "http downgrade is not authorized",
        "kind": "redirect",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "http://api.example.com/v1/next",
        "expect": {
          "authorized": [],
          "reasons": [
            "repo_key:scheme_not_https"
          ]
        }
      },
      {
        "name": "another port is not authorized",
        "kind": "redirect",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "https://api.example.com:8443/v1/next",
        "expect": {
          "authorized": [],
          "reasons": [
            "repo_key:port_mismatch"
          ]
        }
      },
      {
        "name": "a sibling path is not authorized",
        "kind": "redirect",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "https://api.example.com/v10/next",
        "expect": {
          "authorized": [],
          "reasons": [
            "repo_key:path_outside_prefix"
          ]
        }
      },
      {
        "name": "one covering rule authorizes the hop",
        "kind": "redirect",
        "rules": [
          {
            "label": "a",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          },
          {
            "label": "b",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v2",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "https://api.example.com/v2/next",
        "expect": {
          "authorized": [
            "b"
          ],
          "reasons": [
            "a:path_outside_prefix"
          ]
        }
      },
      {
        "name": "a redirect with a placeholder in query is authorized",
        "kind": "redirect",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "query",
              "name": "key"
            }
          }
        ],
        "url": "https://api.example.com/v1/next?key=%7B%7Bck-secret%3Arepo_key%7D%7D",
        "expect": {
          "authorized": [
            "repo_key"
          ],
          "reasons": []
        }
      }
    ]
  }
}
