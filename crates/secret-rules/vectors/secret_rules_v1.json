{
  "description": "Placeholder grammar (P1). Every case is a committed input with the exact parse the crate must produce.",
  "groups": {
    "P1": [
      {
        "name": "plain label",
        "kind": "parse",
        "input": "{{ck-secret:repo_key}}",
        "offset": 0,
        "expect": {
          "label": "repo_key",
          "len": 22,
          "exact": "repo_key"
        }
      },
      {
        "name": "single character label",
        "kind": "parse",
        "input": "{{ck-secret:x}}",
        "offset": 0,
        "expect": {
          "label": "x",
          "len": 15,
          "exact": "x"
        }
      },
      {
        "name": "63 byte label is the longest valid",
        "kind": "parse",
        "input": "{{ck-secret:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}}",
        "offset": 0,
        "expect": {
          "label": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "len": 77,
          "exact": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      {
        "name": "64 byte label is too long",
        "kind": "parse",
        "input": "{{ck-secret:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}}",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "uppercase label is invalid",
        "kind": "parse",
        "input": "{{ck-secret:Repo_Key}}",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "leading hyphen is invalid",
        "kind": "parse",
        "input": "{{ck-secret:-repo}}",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "empty label is invalid",
        "kind": "parse",
        "input": "{{ck-secret:}}",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "shell metacharacters cannot enter a label",
        "kind": "parse",
        "input": "{{ck-secret:a$b}}",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "unterminated placeholder",
        "kind": "parse",
        "input": "{{ck-secret:repo",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "nested placeholder collapses the label",
        "kind": "parse",
        "input": "{{ck-secret:{{lc:repo}}}}",
        "offset": 0,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "well formed placeholder inside a larger text is not exact",
        "kind": "parse",
        "input": "x {{ck-secret:repo_key}} y",
        "offset": 2,
        "expect": {
          "label": "repo_key",
          "len": 22,
          "exact": null
        }
      },
      {
        "name": "offset into the middle of the prefix does not parse",
        "kind": "parse",
        "input": "x {{ck-secret:repo_key}}",
        "offset": 3,
        "expect": {
          "label": null,
          "len": null,
          "exact": null
        }
      },
      {
        "name": "scan reports only well-formed labels but every mention",
        "kind": "scan",
        "input": "a {{ck-secret:one}} b {{ck-secret:Broken}} c {{ck-secret:{{lc:x}}}}",
        "mentions": [
          "one",
          "broken"
        ],
        "expect": {
          "labels": [
            "one"
          ],
          "mentions": {
            "one": true,
            "broken": true
          }
        }
      },
      {
        "name": "scan finds repeated and adjacent placeholders",
        "kind": "scan",
        "input": "{{ck-secret:a}}{{ck-secret:b}} {{ck-secret:a}}",
        "mentions": [
          "a",
          "b",
          "c"
        ],
        "expect": {
          "labels": [
            "a",
            "b",
            "a"
          ],
          "mentions": {
            "a": true,
            "b": true,
            "c": false
          }
        }
      },
      {
        "name": "percent-encoded mention is still a loose mention",
        "kind": "scan",
        "input": "%7B%7Bck-secret%3ARepo%7D%7D",
        "mentions": [
          "repo"
        ],
        "expect": {
          "labels": [],
          "mentions": {
            "repo": true
          }
        }
      }
    ],
    "P2": [
      {
        "name": "bearer whole value substitutes",
        "kind": "request",
        "key": "sk-live-0123456789abcdef",
        "rules": [
          {
            "label": "repo_key",
            "host": "api.example.com",
            "port": 443,
            "path_prefix": "/v1",
            "location": {
              "kind": "bearer"
            }
          }
        ],
        "target": "/v1/things",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{ck-secret:repo_key}}"
          }
        ],
        "expect": {
          "labels": [
            "substituted"
          ],
          "refusal": null,
          "header_edits": [
            {
              "name": "Authorization",
              "replacement": "Bearer sk-live-0123456789abcdef",
              "kind": "whole_value"
            }
          ]
        }
      },
